    "wrong_key": {
      "status": 401,
      "body": {
        "detail": "Invalid or missing API key"
      },
      "expected": 401
    },
    "unicode_wrong_key": {
      "status": 401,
      "body": {
        "detail": "Invalid or missing API key"
      },
      "expected": 401
    },
    "authorized": {
      "status": 200,
      "body": {
        "question": "Hello",
        "answer": "Agent đang hoạt động tốt! (mock response) Hỏi thêm câu hỏi đi nhé.",
        "input_tokens": 1,
        "output_tokens": 16,
        "cost_usd": 9.75e-06,
        "model": "mock-llm"
      },
      "expected": 200
