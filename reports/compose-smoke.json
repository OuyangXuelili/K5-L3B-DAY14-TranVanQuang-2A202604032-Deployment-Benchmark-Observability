    "missing_question": {
      "status": 422,
      "body": {
        "detail": [
          {
            "type": "missing",
            "loc": [
              "body",
              "question"
            ],
            "msg": "Field required",
            "input": {}
          }
        ]
      },
      "expected": 422
    }
  }
